sel.col <- colnames(tt[, colSums(tt == "0") < nrow(tt)])  
sel.row <- rownames(tt[rowSums(tt == "0") == ncol(tt),])  
glom.sc_fromLi <- glom.sc_fromLi[, c("V1", sel.col)]  

