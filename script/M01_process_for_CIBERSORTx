# 筛选 p_val_adj < 0.01 且 avg_log2FC 的绝对值大于对应的阈值，并按 avg_log2FC 从大到小排序  
glom_filtered_marker_ls <- lapply(names(glom.marker.ls), function(cell_type) {  
  df <- glom.marker.ls[[cell_type]]  
  # 获取对应的 avg_log2FC 阈值  
  n <- thresholds[cell_type]  
  filtered_df <- df[df$p_val_adj < 0.01 & abs(df$avg_log2FC) > n, ]  
  # 按照 avg_log2FC 从大到小排序  
  sorted_df <- filtered_df[order(filtered_df$avg_log2FC, decreasing = TRUE), ]  
  cat(paste(cell_type, "筛选后的行数:", nrow(sorted_df), "\n"))  
  return(setNames(list(sorted_df), cell_type))  
})  

 glom_filtered_marker_ls <- setNames(glom_filtered_marker_ls, names(glom.marker.ls))  


glom_topgenes_names <- unique(unlist(lapply(glom_filtered_marker_ls, function(x) rownames(x[[1]]))))  
glom.markerGenePaper = c()
