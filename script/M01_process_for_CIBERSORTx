
## CIBERSORTx
### scRNA-seq pre-process
#### 1. PBMC
- reference 制作：这里是随机从981个样本中抽了10个样本做reference，剩下的971个样本做pseudobulk RNA-seq; code: /node1/zhaoq/scTWAS_PBMC/CIBERSORTx/Reference/CIBERSORTX_10reference_extract.r
1. 提取10个样本（随机）及其表达矩阵
``` r
setwd('/node1/zhaoq/scTWAS_PBMC/CIBERSORTx')
library("tidyverse")
library("dsLib")
#remotes::install_github("joseah/dsLib")
# Secondary
library("Seurat")
library("Nebulosa")
library("colorspace")

# Input
input = '/node1/zhaoq/scTWAS_PBMC/Pre_scRNA-seq/pbmc_14_CellType_geneIDtoSymbol_ProCoding.rds'

# Read file
inicio("Reading gene expression data")
data <- readRDS(input)
fin()
#data中提取出那10个样本的，因为之前没写出(随机选出的，但之前没设置随机种子)
random_samples  <- c('395_396', '222_223', '888_889', '564_565', '981_982', '358_359', '962_963', '353_354', '653_654', '610_611')

###20250107在这里加上细胞类型合并，以后的TPM代码也要修改，暂没修改
data$cell_label <- as.character(data$cell_label)
#细胞类型进行合并 
data$cell_label[data$cell_label %in% c("CD4 NC", "CD4 ET", "CD4 SOX4")] <- "CD4T"  
data$cell_label[data$cell_label %in% c("CD8 ET", "CD8 NC", "CD8 S100B")] <- "CD8T"  
data$cell_label[data$cell_label  %in% c("NK", "NK R")] <- "NK"
data$cell_label[data$cell_label %in% c("B IN", "B Mem")] <- "B"
data$cell_label[data$cell_label  %in% c("Mono C", "Mono NC")] <- "Mono"

extracted_data_971samples <- data[, !data@meta.data$individual %in% random_samples]

extracted_data_10samples <- subset(x=data, subset=individual%in% random_samples)

#合并细胞类型后的是7_CellType
saveRDS(extracted_data_971samples,'/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/pbmc_7_CellType_971samples.rds')
saveRDS(extracted_data_10samples,'/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/Reference/pbmc_7_CellType_10samples.rds')

##之前的代码未合并的是14_CellType
#saveRDS(extracted_data_971samples,'/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/pbmc_14_CellType_971samples.rds')
#saveRDS(extracted_data_10samples,'/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/Reference/pbmc_14_CellType_10samples.rds')

#提取单细胞表达矩阵（这是之前的14CT的，20250107更新后使用的是7CT）
#extracted_data_10samples= readRDS('/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/Reference/pbmc_14_CellType_10samples.rds')
tmp_scRNA_10sample = GetAssayData(extracted_data_10samples, layer = "counts", assay = "RNA")
colnames(tmp_scRNA_10sample) = extracted_data_10samples$cell_label
tmp_scRNA_10sample = data.frame(tmp_scRNA_10sample, check.names = F)   # 一定要有check.names = F，不然的话后面重新命名列名会有问题，matrix对象不允许列名相同，但data.frame对象允许
tmp_scRNA_10sample = data.frame(gene = rownames(tmp_scRNA_10sample), tmp_scRNA_10sample, check.names = F)
table(colnames(tmp_scRNA_10sample))
write.table(tmp_scRNA_10sample, file = './Reference/pbmc_7_CellType_10samples_expCount.txt', sep = "\t") 
