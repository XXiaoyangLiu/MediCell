- 971samples pseudobulk and TPM：
```r
#pseudobulk:Sum
library(scater)
library(Seurat)
library(tidyverse)
library(cowplot)
library(Matrix.utils)
library(edgeR)
library(dplyr)
library(magrittr)
library(Matrix)
library(purrr)
library(reshape2)
library(S4Vectors)
library(tibble)
library(SingleCellExperiment)

data = readRDS('/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/pbmc_7_CellType_971samples.rds')

# 从前期的单细胞分析结果中提出 counts 文件和 metadata 文件
        pesudo_counts <- data@assays$RNA@counts
        pesudo_metadata <- data@meta.data
# 继续从单细胞分析结果中把降维聚类的结果和细胞ID提出来
        pesudo_metadata$cluster_id <- factor(data@meta.data$cell_label)
        pesudo_metadata$sample_id <- factor(data@meta.data$individual)
        sce_bulk <- SingleCellExperiment(assay = list(counts = pesudo_counts),
                                         colData = pesudo_metadata)
groups <- colData(sce_bulk)[, c("cluster_id", "sample_id")]

pb <- aggregate.Matrix(t(counts(sce_bulk)), groupings = groups$sample_id, fun = "sum")

# 表达矩阵是 行是基因 列是样本 所以行列转换一下
pb_t <- t(pb)

write.table(pb_t, file = 'pbmc_7_CellType_971samples_pseudobulk_expCount.txt', sep = "\t")


#tpm:
mycounts<-read.csv("/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/pbmc_7_CellType_971samples_pseudobulk_expCount.txt",sep='\t',check.names = FALSE)
head(mycounts)

#基因长度文件是之前写出没有进行ID转换
## 利用GenomicFeatures包导入gtf处理
library(GenomicFeatures)
txdb <- makeTxDbFromGFF("/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/Homo_sapiens.GRCh37.82.chr_patch_hapl_scaff.gtf.gz",
 format="gtf") 
exons_gene <- exonsBy(txdb, by = "gene") 
head(exons_gene)

##计算总外显子长度：用reduce去除掉重叠冗余的部分，,width统计长度，最后计算总长度
exons_gene_lens <- parLapply(cl,exons_gene,function(x){sum(width(reduce(x)))}) 
exons_gene_lens[1:10]
    
geneid_efflen <- data.frame(geneid=names(exons_gene_lens),
                                efflen=as.numeric(exons_gene_lens))
geneid_efflen_gtf1 <- geneid_efflen
write.csv(geneid_efflen_gtf1,file='/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/geneid_efflen_gtf.txt')

gene_effective_len = read.csv('/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/geneid_efflen_gtf.txt',sep='\t')
id_trans=read.csv('/node1/zhaoq/scTWAS_PBMC/GeneID_Trans_Gh37_release84.csv')
gene_effective_len$GeneSymbol= id_trans[match(gene_effective_len$geneid, id_trans$GeneID),2]
gene_effective_len=na.omit(gene_effective_len)

mycounts$geneLength = gene_effective_len[match(rownames(mycounts), gene_effective_len$GeneSymbol),2]

kb <- mycounts$geneLength / 1000
head(kb)

countdata <- mycounts[,1:971]
head(countdata)
rpk <- countdata / kb
head(rpk)

tpm <- t(t(rpk)/colSums(rpk) * 1000000)
#20245 genes, 971 samples

# 将行名转换为数据框的一列，放在第一列
tpm=as.data.frame(tpm)
tpm$GeneSymbol <- rownames(tpm)  
tpm <- tpm[, c("GeneSymbol", setdiff(names(tpm), "GeneSymbol"))]

write.table(tpm, file = '/node1/zhaoq/scTWAS_PBMC/CIBERSORTx/pbmc_14_CellType_971samples_pseudobulk_TPM.txt', sep = "\t",quote = FALSE, row.names = FALSE)

```


#### 2. kidney
- reference 制作：用findmarkers函数对每个细胞类型使用不同logFC阈值找maker，确定marker后在盛老师之前求好的TPM矩阵中提取marker基因的单细胞表达矩阵作为CIBERSORTx的输入
#### scRNA-seq:保留了全部基因，不止蛋白编码基因，因为CIBERSORTx时尝试过只用蛋白编码基因但结果不好，在ENIGMA那步只保留蛋白编码基因了。
```r
#以下代码是修改了盛老师之前的代码（YoungscRNAtpmCal.R），从young的scRNA-seq中提取特定细胞类型数据分别组成glom和tub的scRNA-seq数据
library(Seurat)
load('/public/home/Shenglab/DataShare/ToZhaoqiong/scTWAS_info/YoungscRNAseqKidneyAddImmune.RData')
myNew = UpdateSeuratObject(object = myNew)
myNew = NormalizeData(myNew,scale.factor=1e4)
read.table("/node1/zhaoq/scTWAS_Kidney/YoungCellAssign.txt",header=T,sep='\t')->cells
rownames(cells)<-paste0(cells$SangerID,"_",cells$barcode)
GetAssayData(object=myNew,,slot='data')->exp
rownames(myNew@meta.data)->subid
cells[subid,]$ClusterID->myNew@meta.data$ClusterID
read.table("/node1/zhaoq/scTWAS_Kidney/YoungClusterInfo.txt",header=T,sep="\t",row.name=1)->assign
assign[myNew@meta.data$ClusterID,]$Alias->myNew@meta.data$CT
assign[myNew@meta.data$ClusterID,]$Cell_type1->myNew@meta.data$CellType1
summary(as.factor(myNew@meta.data$CellType1))
assign[myNew@meta.data$ClusterID,]$Cell_type2->myNew@meta.data$CellType2
summary(as.factor(myNew@meta.data$CellType2))
assign[myNew@meta.data$ClusterID,]$Cell_type3->myNew@meta.data$CellType3
myNew@meta.data$Combine<-paste0(myNew@meta.data$ClusterID,"_",myNew@meta.data$CT,"_",myNew@meta.data$CellType1,"_",myNew@meta.data$CellType2,"_",myNew@meta.data$CellType3)
summary(as.factor(myNew@meta.data$Combine))->cc
summary(as.factor(myNew@meta.data$ClusterID))
as.factor(myNew@meta.data$Combine)->myNew@meta.data$myCT
levels(myNew@meta.data$myCT)->ori
newct<-c("LOH","NE","Uro","Podo","PT","PT","DCT","Uro","CDICA","CDICB","MC","Uro","Endo","Pelvis","Fib","PT","Uro","NE","Endo","NE","NE","Endo","LOH","Endo")
newct2<-c("NK","NKT","CD8T","Neutrophil","Private","Bcell","NK","Mast_cell","Plasmacytoid_DC","Junk","Junk","Private","Junk","Th_cell","Private","MNP","MNP","MNP","NKT")
allnewct<-c(newct2,newct)
levels(myNew@meta.data$myCT)<-allnewct
myNew@meta.data$predicted.id<-as.character(myNew@meta.data$myCT)
myNew@meta.data->cellinfo
##先提取glom和tub的细胞
glom_cell <- c('NK', 'NKT', 'Th_cell', 'CD8T', 'Bcell', 'Plasmacytoid_DC',   
                'Neutrophil', 'MNP', 'MC', 'Endo', 'Podo', 'Mast_cell')  

tub_cell <- c("Bcell", "CD8T", "CDICA", "CDICB", "DCT", "LOH", "Mast_cell",   
               "MNP", "Neutrophil", "NK", "NKT", "Plasmacytoid_DC", "PT", "Th_cell")  
glom.myNew <- subset(myNew, subset = myCT %in% glom_cell)  #33694genes
tub.myNew <- subset(myNew, subset = myCT %in% tub_cell)  #33694 genes

```

### Bulk处理：gene symbol unique;保留蛋白编码基因（for ENIGMA）
```r
##参考基因组GeneID与GeneSymbol转换
library(rtracklayer)  
library(dplyr)  
gtf_file <- "/public/home/Shenglab/DataShare/Reference/human/hg19/gencode.v19.annotation.gtf"  #在盛老师的NG中确认了是hg19
gtf_data <- import(gtf_file)  
gene_info <- gtf_data[gtf_data$type == "gene", ]  
gene_info <-gene_info[gene_info$gene_type == "protein_coding", ] 
gene_ids <- gene_info$gene_id  
gene_names <- gene_info$gene_name  
bulk_ref <- data.frame(GeneID = gene_ids, GeneSymbol = gene_names, stringsAsFactors = FALSE)  #20345 protein coding genes

####CIBERSORTx是输入TPM数据和全部基因
bulk_tub_tpm=read.table('/public/home/Shenglab/DataShare/ToZhaoqiong/scTWAS_info/NG_kidney_fromSX/tub.bulk.EXP.tpm.Name.txt',header=T) #42855genes  
bulk_tub_allgene_tpm <- bulk_tub_tpm %>%   
  filter(!Gene %in% Gene[duplicated(Gene)])   #42005 genes
write.table(bulk_tub_allgene_tpm,file='/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/tub/input/tub.bulk.EXP.tpm.Name.Unique.txt',sep='\t') 

bulk_glom_tpm=read.table('/public/home/Shenglab/DataShare/ToZhaoqiong/scTWAS_info/NG_kidney_fromSX/glom.bulk.EXP.tpm.Name.txt',header=T) #42872genes 
bulk_glom_allgene_tpm <- bulk_glom_tpm %>%   
  filter(!Gene %in% Gene[duplicated(Gene)])   #42066 genes
write.table(bulk_glom_allgene_tpm,file='/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/glom/input/glom.bulk.EXP.tpm.Name.Unique.txt',sep='\t') 

###ENIGMA输入（只保留蛋白编码基因）
bulk_tub_new_tpm<- subset(bulk_tub_tpm, Gene%in% bulk_ref$GeneSymbol) #18961genes
bulk_tub_new_tpm <- bulk_tub_new_tpm %>%   
  filter(!Gene %in% Gene[duplicated(Gene)]) #18759genes
write.table(bulk_tub_new_tpm,file='/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/tub/input/tub.bulk.EXP.tpm.Name.Unique.ProtCoding.txt',sep='\t')

bulk_glom_tpm=read.table('/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/glom/input/glom.bulk.EXP.tpm.Name.Unique.txt',header=T) #42066genes 
bulk_glom_tpm_new <- subset(bulk_glom_tpm, Gene %in% bulk_ref$GeneSymbol) #18913 genes  
bulk_glom_tpm_new <- bulk_glom_tpm_new %>%   
  filter(!Gene %in% Gene[duplicated(Gene)]) #18711 genes  

write.table(bulk_glom_tpm_new, file='/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/glom/input/glom.bulk.EXP.tpm.Name.Unique.ProtCoding.txt', sep='\t', row.names = FALSE)

####################################################以下是count输入的###########################################################
#####ENIGNA如果输入count数据，参数do_cpm默认为T，会自动对基因表达矩阵进行CPM标准化；未采用
################count数据处理
load('/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_count/count/allCountsAllRNA.RData') #盛老师20250121新发我的count
glom_tpm=read.table('/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/glom/input/glom.bulk.EXP.tpm.Name.Unique.txt') #先在count里提取跟tpm一样的samples（这个是原始的）
glom_counts_filtered <- glom.counts[, intersect(colnames(glom_tpm),colnames(glom.counts)), drop = FALSE]  
str(glom_counts_filtered)   
write.table(glom_counts_filtered, file = "/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_count/count/glom_counts_303samples_geneID.txt") 

tub_tpm =read.table('/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_TPM/tub/input/pre/tub.bulk.EXP.tpm.Name.Unique.txt')
tub_counts_filtered <- tub.counts[, intersect(colnames(tub_tpm),colnames(tub.counts)), drop = FALSE]  
str(tub_counts_filtered)   
write.table(tub_counts_filtered, file = "/node1/zhaoq/scTWAS_Kidney/ENIGMA/max_L2_count/count/tub_counts_356samples_geneID.txt") 

############# tub
tub_counts_filtered$GeneID <- rownames(tub_counts_filtered)  
bulk_tub_new <- merge(tub_counts_filtered, bulk_ref, by.x = "GeneID", by.y = "GeneID", all.x = TRUE)   
bulk_tub_new <- cbind(GeneSymbol = bulk_tub_new$GeneSymbol, bulk_tub_new[, -which(names(bulk_tub_new) == "GeneSymbol")])  
