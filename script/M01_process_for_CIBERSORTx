  df <- tub.marker.ls[[cell_type]]  
  n <- thresholds[cell_type]  
  filtered_df <- df[df$p_val_adj < 0.01 & abs(df$avg_log2FC) > n, ]  
  # 按照 avg_log2FC 从大到小排序  
  sorted_df <- filtered_df[order(filtered_df$avg_log2FC, decreasing = TRUE), ]  
  cat(paste(cell_type, "筛选后的行数:", nrow(sorted_df), "\n"))  
  return(setNames(list(sorted_df), cell_type))  
})  

